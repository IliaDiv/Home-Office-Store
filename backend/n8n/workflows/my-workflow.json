    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT o.id, o.total_amount, o.status, o.created_at,\n       json_agg(\n           json_build_object(\n               'product_name', p.name,\n               'quantity', oi.quantity,\n               'price', oi.price\n           )\n       ) as items\nFROM orders o\nLEFT JOIN order_items oi ON o.id = oi.order_id\nLEFT JOIN products p ON oi.product_id = p.id\nWHERE o.user_id = {{ $node[\"Format message to JSON\"].json.userId }}\nGROUP BY o.id, o.total_amount, o.status, o.created_at;",
